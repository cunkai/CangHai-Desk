<?xml version="1.0" encoding="utf-8"?>
<!--
  沧海置顶指针 / 手柄导航服务配置。

  该服务以 TYPE_ACCESSIBILITY_OVERLAY（z 序 layer 31）绘制统一软件指针，
  高于 NAVIGATION_BAR(24) 与 NAVIGATION_BAR_PANEL(25，即三星 DeX 底部横条)，
  只需在系统设置中开启一次即可（Samsung 拦截 shell 静默写入，无法代开）。
  同时订阅 SOURCE_MOUSE 原始事件流（API 34+），让 USB 物理鼠标在
  任意窗口上方都能拿到真实坐标。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_cursor_desc" />
